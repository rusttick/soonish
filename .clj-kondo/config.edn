;; clj-kondo settings. Only the owner changes this file.
;; Stricter than the defaults; the project's own rules are in guard/rules.edn.
{:linters {:shadowed-var {:level :warning}
           :missing-docstring {:level :warning}
           :refer-all {:level :error}
           :use {:level :error}
           :unsorted-required-namespaces {:level :warning}
           :single-key-in {:level :warning}
           :redundant-fn-wrapper {:level :warning}
           :redundant-call {:level :warning}
           :reduce-without-init {:level :warning}
           :def-fn {:level :warning}
           :used-underscored-binding {:level :warning}
           :aliased-namespace-symbol {:level :warning}
           :docstring-leading-trailing-whitespace {:level :warning}
           :main-without-gen-class {:level :off}}

 :lint-as {clojure.test.check.clojure-test/defspec clojure.test/deftest
           clojure.test.check.properties/for-all clojure.core/let}}
